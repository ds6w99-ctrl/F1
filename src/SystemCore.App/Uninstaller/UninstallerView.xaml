<UserControl x:Class="SystemCore.App.Uninstaller.UninstallerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:f1="using:SystemCore.App.DesignSystem">
  <Grid Padding="32,12" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
    <TextBlock x:Name="Title" Style="{StaticResource F1PageTitleStyle}" FontSize="28" VerticalAlignment="Center" AutomationProperties.AutomationId="PageTitle"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="Refresh" Click="OnRefresh" Style="{StaticResource F1PrimaryButtonStyle}" MinHeight="40" FontSize="14" Padding="12,8" AutomationProperties.AutomationId="UnRefresh"/><Button x:Name="CancelOperation" Click="OnCancelOperation" Padding="12,8" AutomationProperties.AutomationId="UnCancelOperation"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" ColumnDefinitions="*,140,140" ColumnSpacing="8">
    <TextBox x:Name="Search" TextChanged="OnSearch" AutomationProperties.AutomationId="UnSearch"/>
    <ComboBox x:Name="Filter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnFilter" AutomationProperties.AutomationId="UnFilter"/>
    <ComboBox x:Name="Sort" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="OnSort" AutomationProperties.AutomationId="UnSort"/>
   </Grid>
   <TextBlock x:Name="Status" Grid.Row="2" TextTrimming="CharacterEllipsis" MaxLines="1" AutomationProperties.AutomationId="UnStatus"/>
   <ListView x:Name="Applications" Grid.Row="3" SelectionMode="Single" SelectionChanged="OnSelection" ContainerContentChanging="OnContainerChanging" AutomationProperties.AutomationId="UnApplications" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource F1ListItemStyle}"><Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="52"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,36,*,Auto" ColumnSpacing="10" BorderBrush="{ThemeResource F1BlueBrush}">
     <CheckBox x:Name="Choice" MinWidth="0" Width="32" Visibility="Collapsed" Checked="OnLeftoverToggle" Unchecked="OnLeftoverToggle"/>
     <Image x:Name="AppIcon" Grid.Column="1" Width="36" Height="36" Stretch="Uniform" Source="ms-appx:///Assets/Brand/F1_Logo.png" AutomationProperties.AccessibilityView="Raw"/>
     <TextBlock x:Name="RowText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2"/>
     <TextBlock x:Name="RowMetadata" Grid.Column="3" VerticalAlignment="Center" FontSize="12" FlowDirection="LeftToRight" TextReadingOrder="UseFlowDirection"/>
    </Grid></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12"><Button x:Name="Previous" Click="OnPrevious" MinHeight="32" Padding="12,4" AutomationProperties.AutomationId="UnPrevious"/><TextBlock x:Name="PageNumber" VerticalAlignment="Center" AutomationProperties.AutomationId="UnCount"/><Button x:Name="Next" Click="OnNext" MinHeight="32" Padding="12,4" AutomationProperties.AutomationId="UnNext"/></StackPanel>
   <Border Grid.Row="5" Style="{StaticResource CardStyle}" Padding="12,8"><StackPanel Spacing="6">
    <ScrollViewer MaxHeight="48"><StackPanel Spacing="8"><TextBlock x:Name="Details" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="UnDetails"/><TextBlock x:Name="LeftoverSummary" TextWrapping="Wrap" AutomationProperties.AutomationId="UnLeftoverSummary"/><TextBlock x:Name="CleanupSummary" TextWrapping="Wrap" AutomationProperties.AutomationId="UnCleanupSummary"/></StackPanel></ScrollViewer>
   <f1:F1WrapPanel><Button x:Name="Uninstall" Click="OnUninstall" Style="{StaticResource DangerButtonStyle}" AutomationProperties.AutomationId="UnUninstall"/><Button x:Name="ScanLeftovers" Click="OnScanLeftovers" AutomationProperties.AutomationId="UnScanLeftovers"/><Button x:Name="DeleteLeftovers" Click="OnDeleteLeftovers" Style="{StaticResource DangerButtonStyle}" AutomationProperties.AutomationId="UnDeleteLeftovers"/></f1:F1WrapPanel>
  </StackPanel></Border>
  </Grid>
</UserControl>
