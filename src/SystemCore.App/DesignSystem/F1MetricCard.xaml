<UserControl x:Class="SystemCore.App.DesignSystem.F1MetricCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource CardStyle}" Padding="24,20" FlowDirection="LeftToRight">
    <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="14"><FontIcon x:Name="Icon" FontSize="28"/><TextBlock x:Name="Title" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      <Grid Width="196" Height="196" HorizontalAlignment="Center" Margin="0,4,0,0">
        <Ellipse Stroke="{ThemeResource F1BorderBrush}" StrokeThickness="1" Margin="0"/>
        <Ellipse Stroke="{ThemeResource F1TrackBrush}" StrokeThickness="8" Margin="10"/>
        <Ellipse Fill="{ThemeResource F1RaisedBrush}" Margin="36"/>
        <Path x:Name="Glow" StrokeThickness="15" Opacity="{ThemeResource F1GlowOpacity}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path x:Name="Arc" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <StackPanel VerticalAlignment="Center" Spacing="6" Margin="28,0"><TextBlock x:Name="Value" FontSize="34" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="Detail" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource F1SecondaryBrush}"/></StackPanel>
      </Grid>
      <Grid x:Name="Plot" Height="44" SizeChanged="OnPlotSizeChanged" IsHitTestVisible="False"><Path x:Name="Line" StrokeThickness="1.6"/></Grid>
      <Border Height="1" Background="{ThemeResource F1BorderBrush}"/>
      <TextBlock x:Name="Metadata" FontSize="13" Foreground="{ThemeResource F1SecondaryBrush}" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</UserControl>
