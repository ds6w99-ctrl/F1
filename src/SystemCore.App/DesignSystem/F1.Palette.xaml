<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="F1BackgroundColor">#030B15</Color><Color x:Key="F1SidebarColor">#061322</Color>
      <Color x:Key="F1SurfaceColor">#07182A</Color><Color x:Key="F1RaisedColor">#0B2037</Color>
      <Color x:Key="F1BorderColor">#174A6B</Color><Color x:Key="F1TextColor">#F4F8FF</Color>
      <Color x:Key="F1SecondaryColor">#B3CBE4</Color><Color x:Key="F1MutedColor">#839CB8</Color>
      <Color x:Key="F1BlueColor">#29CAFF</Color><Color x:Key="F1PurpleColor">#AD7BFF</Color><Color x:Key="F1TealColor">#00DFC5</Color>
      <Color x:Key="F1DangerColor">#FF667A</Color><Color x:Key="F1HoverColor">#14375A</Color>
      <Color x:Key="F1TrackColor">#18364F</Color><Color x:Key="F1SelectedColor">#123D68</Color>
      <LinearGradientBrush x:Key="F1ActionBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#009DFF"/><GradientStop Color="#0054DA" Offset="0.4"/><GradientStop Color="#063C72" Offset="1"/></LinearGradientBrush>
      <SolidColorBrush x:Key="F1ActionTextBrush" Color="White"/>
      <x:Double x:Key="F1GlowOpacity">0.2</x:Double>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="F1BackgroundColor">#EDF3FA</Color><Color x:Key="F1SidebarColor">#E2ECF8</Color>
      <Color x:Key="F1SurfaceColor">#FFFFFF</Color><Color x:Key="F1RaisedColor">#E9F2FD</Color>
      <Color x:Key="F1BorderColor">#9EB9D5</Color><Color x:Key="F1TextColor">#102840</Color>
      <Color x:Key="F1SecondaryColor">#385B7B</Color><Color x:Key="F1MutedColor">#496882</Color>
      <Color x:Key="F1BlueColor">#006BBD</Color><Color x:Key="F1PurpleColor">#7541CE</Color><Color x:Key="F1TealColor">#007D70</Color>
      <Color x:Key="F1DangerColor">#BE243F</Color><Color x:Key="F1HoverColor">#CEE5FA</Color>
      <Color x:Key="F1TrackColor">#CEDFEB</Color><Color x:Key="F1SelectedColor">#BEDFFF</Color>
      <LinearGradientBrush x:Key="F1ActionBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#006CBD"/><GradientStop Color="#004CA3" Offset="1"/></LinearGradientBrush>
      <SolidColorBrush x:Key="F1ActionTextBrush" Color="White"/>
      <x:Double x:Key="F1GlowOpacity">0.08</x:Double>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <Color x:Key="F1BackgroundColor">{ThemeResource SystemColorWindowColor}</Color><Color x:Key="F1SidebarColor">{ThemeResource SystemColorWindowColor}</Color>
      <Color x:Key="F1SurfaceColor">{ThemeResource SystemColorWindowColor}</Color><Color x:Key="F1RaisedColor">{ThemeResource SystemColorWindowColor}</Color>
      <Color x:Key="F1BorderColor">{ThemeResource SystemColorWindowTextColor}</Color><Color x:Key="F1TextColor">{ThemeResource SystemColorWindowTextColor}</Color>
      <Color x:Key="F1SecondaryColor">{ThemeResource SystemColorWindowTextColor}</Color><Color x:Key="F1MutedColor">{ThemeResource SystemColorGrayTextColor}</Color>
      <Color x:Key="F1BlueColor">{ThemeResource SystemColorHotlightColor}</Color><Color x:Key="F1PurpleColor">{ThemeResource SystemColorHotlightColor}</Color><Color x:Key="F1TealColor">{ThemeResource SystemColorHotlightColor}</Color>
      <Color x:Key="F1DangerColor">{ThemeResource SystemColorWindowTextColor}</Color><Color x:Key="F1HoverColor">{ThemeResource SystemColorHighlightColor}</Color>
      <Color x:Key="F1TrackColor">{ThemeResource SystemColorGrayTextColor}</Color><Color x:Key="F1SelectedColor">{ThemeResource SystemColorHighlightColor}</Color>
      <SolidColorBrush x:Key="F1ActionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="F1ActionTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
      <x:Double x:Key="F1GlowOpacity">0</x:Double>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <SolidColorBrush x:Key="F1PageBrush" Color="{ThemeResource F1BackgroundColor}" />
  <SolidColorBrush x:Key="F1SidebarBrush" Color="{ThemeResource F1SidebarColor}" />
  <SolidColorBrush x:Key="F1SurfaceBrush" Color="{ThemeResource F1SurfaceColor}" />
  <SolidColorBrush x:Key="F1RaisedBrush" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="F1BorderBrush" Color="{ThemeResource F1BorderColor}" />
  <SolidColorBrush x:Key="F1TextBrush" Color="{ThemeResource F1TextColor}" />
  <SolidColorBrush x:Key="F1SecondaryBrush" Color="{ThemeResource F1SecondaryColor}" />
  <SolidColorBrush x:Key="F1MutedBrush" Color="{ThemeResource F1MutedColor}" />
  <SolidColorBrush x:Key="F1BlueBrush" Color="{ThemeResource F1BlueColor}" />
  <SolidColorBrush x:Key="F1PurpleBrush" Color="{ThemeResource F1PurpleColor}" />
  <SolidColorBrush x:Key="F1TealBrush" Color="{ThemeResource F1TealColor}" />
  <SolidColorBrush x:Key="F1DangerBrush" Color="{ThemeResource F1DangerColor}" />
  <SolidColorBrush x:Key="F1TrackBrush" Color="{ThemeResource F1TrackColor}" />
  <SolidColorBrush x:Key="F1HoverBrush" Color="{ThemeResource F1HoverColor}" />
  <SolidColorBrush x:Key="F1SelectedBrush" Color="{ThemeResource F1SelectedColor}" />
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource F1TextColor}" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource F1SecondaryColor}" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{ThemeResource F1MutedColor}" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource F1SurfaceColor}" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource F1BorderColor}" />
  <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{ThemeResource F1BackgroundColor}" />
  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{ThemeResource F1DangerColor}" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{ThemeResource F1HoverColor}" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{ThemeResource F1BorderColor}" />
  <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource F1SurfaceColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="FlyoutBackground" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="ContentDialogBackground" Color="{ThemeResource F1SurfaceColor}" />
  <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource F1SidebarColor}" />
  <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource F1SidebarColor}" />
  <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelected" Color="{ThemeResource F1BlueColor}" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource F1HoverColor}" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{ThemeResource F1SelectedColor}" />
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource F1SelectedColor}" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource F1HoverColor}" />
  <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource F1SecondaryColor}" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource F1TextColor}" />
  <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource F1BlueColor}" />
  <SolidColorBrush x:Key="ToolTipBackground" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="ToolTipForeground" Color="{ThemeResource F1TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="ExpanderContentBackground" Color="{ThemeResource F1SurfaceColor}" />
  <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{ThemeResource F1RaisedColor}" />
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource F1BlueColor}" />
</ResourceDictionary>
