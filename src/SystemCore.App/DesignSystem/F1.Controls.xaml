<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Thickness x:Key="F1PagePadding">32,24,32,24</Thickness>
  <CornerRadius x:Key="F1CardRadius">16</CornerRadius>
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource F1SurfaceBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource F1BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable"/><Setter Property="Foreground" Value="{ThemeResource F1TextBrush}"/></Style>
  <Style x:Key="F1PageTitleStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{ThemeResource F1TextBrush}"/></Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="18,10"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Foreground" Value="{ThemeResource F1TextBrush}"/><Setter Property="UseSystemFocusVisuals" Value="True"/></Style>
  <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Foreground" Value="{ThemeResource F1TextBrush}"/></Style>
  <Style TargetType="AutoSuggestBox"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/></Style>
  <Style TargetType="ComboBox"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Foreground" Value="{ThemeResource F1TextBrush}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{ThemeResource F1TextBrush}"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="ToggleSwitch"><Setter Property="Foreground" Value="{ThemeResource F1TextBrush}"/></Style>
  <Style TargetType="Expander"><Setter Property="CornerRadius" Value="16"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderBrush" Value="{ThemeResource F1BorderBrush}"/><Setter Property="Background" Value="{ThemeResource F1SurfaceBrush}"/></Style>
  <Style TargetType="ListView"><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{ThemeResource F1SurfaceBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource F1BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="F1ListItemStyle" TargetType="ListViewItem"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{ThemeResource F1TextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="ListViewItem" BasedOn="{StaticResource F1ListItemStyle}"/>
  <Style TargetType="ContentDialog"><Setter Property="CornerRadius" Value="16"/><Setter Property="Foreground" Value="{ThemeResource F1TextBrush}"/><Setter Property="Background" Value="{ThemeResource F1SurfaceBrush}"/></Style>
  <Style TargetType="NavigationViewItem"><Setter Property="MinHeight" Value="48"/><Setter Property="Margin" Value="8,3"/><Setter Property="CornerRadius" Value="12"/><Setter Property="FontSize" Value="16"/></Style>
  <Style x:Key="DangerButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="{ThemeResource F1DangerBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource F1DangerBrush}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/></Style>
  <Style x:Key="F1PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="24,12"/><Setter Property="CornerRadius" Value="14"/>
    <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Background" Value="{ThemeResource F1ActionBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource F1ActionTextBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource F1BlueBrush}"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="F1BrandItemStyle" TargetType="NavigationViewItem">
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="NavigationViewItem"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
