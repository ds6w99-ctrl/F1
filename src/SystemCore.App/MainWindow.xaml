<Window x:Class="SystemCore.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" FlowDirection="LeftToRight" RowDefinitions="48,*">
    <Border x:Name="SolidBackground" Grid.RowSpan="2" Background="{ThemeResource F1PageBrush}" />
    <Image x:Name="Scenery" Grid.RowSpan="2" Source="ms-appx:///Assets/F1/mountains-placeholder.svg" Stretch="UniformToFill" Opacity="0.62" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
    <Grid Grid.Row="0" ColumnDefinitions="*,44,44,Auto" Padding="16,0,0,0">
      <Grid x:Name="TitleDragRegion" Background="Transparent"><TextBlock Text="{x:Bind ViewModel.ProductName}" FontSize="13" Foreground="{ThemeResource F1SecondaryBrush}" VerticalAlignment="Center" /></Grid>
      <Button Grid.Column="1" Width="40" Height="36" MinHeight="0" Padding="8" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="F1Search" AutomationProperties.Name="{x:Bind ViewModel.SearchLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.SearchLabel, Mode=OneWay}">
        <FontIcon Glyph="&#xE721;" FontSize="18"/>
        <Button.Flyout><Flyout x:Name="SearchFlyout"><AutoSuggestBox x:Name="PageSearch" Width="280" PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SearchLabel, Mode=OneWay}" TextChanged="OnSearchChanged" QuerySubmitted="OnSearchSubmitted" SuggestionChosen="OnSearchChosen" QueryIcon="Find" /></Flyout></Button.Flyout>
      </Button>
      <Button Grid.Column="2" Width="40" Height="36" MinHeight="0" Padding="8" Background="Transparent" BorderThickness="0" Click="OpenSettings" AutomationProperties.AutomationId="F1Settings" AutomationProperties.Name="{x:Bind ViewModel.SettingsLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.SettingsLabel, Mode=OneWay}"><FontIcon Glyph="&#xE713;" FontSize="18"/></Button>
      <Border Grid.Column="3" x:Name="CaptionInset" Width="146" />
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
      Background="Transparent" PaneDisplayMode="Auto" IsPaneOpen="True" OpenPaneLength="294" CompactPaneLength="56" SelectionChanged="OnNavigationChanged"
      PaneOpened="OnPaneOpened" PaneClosed="OnPaneClosed" AutomationProperties.Name="{x:Bind ViewModel.NavigationLabel, Mode=OneWay}">
      <NavigationView.PaneHeader>
        <Grid x:Name="PaneHeaderText" Padding="18,10,12,22" ColumnDefinitions="62,*" ColumnSpacing="10">
          <Image Source="ms-appx:///Assets/Brand/F1_Logo.png" Width="58" Height="58" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind ViewModel.ProductName}" FontSize="40" FontWeight="Bold"/><TextBlock Text="{x:Bind ViewModel.Tagline}" FontSize="9" CharacterSpacing="80" Foreground="{ThemeResource F1SecondaryBrush}"/></StackPanel>
        </Grid>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="DashboardItem" Content="{x:Bind ViewModel.DashboardLabel, Mode=OneWay}" Tag="Dashboard" Icon="Home" AutomationProperties.AutomationId="NavDashboard" />
        <NavigationViewItem Content="{x:Bind ViewModel.SystemInfoLabel, Mode=OneWay}" Tag="SystemInfo" Icon="View" AutomationProperties.AutomationId="NavSystemInfo" />
        <NavigationViewItem x:Name="PerformanceItem" Content="{x:Bind ViewModel.PerformanceLabel, Mode=OneWay}" Tag="Performance" Icon="Manage" IsExpanded="True" AutomationProperties.AutomationId="NavPerformance">
          <NavigationViewItem.MenuItems><NavigationViewItem Content="{x:Bind ViewModel.MemoryToolsLabel, Mode=OneWay}" Tag="MemoryTools" Icon="AllApps" AutomationProperties.AutomationId="NavMemoryTools" MinHeight="36" FontSize="14"/></NavigationViewItem.MenuItems>
        </NavigationViewItem>
        <NavigationViewItem Content="{x:Bind ViewModel.CleanerLabel, Mode=OneWay}" Tag="Cleaner" Icon="Delete" AutomationProperties.AutomationId="NavCleaner" />
        <NavigationViewItem Content="{x:Bind ViewModel.UninstallerLabel, Mode=OneWay}" Tag="Uninstaller" Icon="AllApps" AutomationProperties.AutomationId="NavUninstaller" />
        <NavigationViewItem Content="{x:Bind ViewModel.StartupLabel, Mode=OneWay}" Tag="Startup" Icon="Play" AutomationProperties.AutomationId="NavStartup" />
        <NavigationViewItem Content="{x:Bind ViewModel.ToolsLabel, Mode=OneWay}" Tag="Tools" Icon="Repair" AutomationProperties.AutomationId="NavTools" />
        <NavigationViewItem Content="{x:Bind ViewModel.SettingsLabel, Mode=OneWay}" Tag="Settings" Icon="Setting" AutomationProperties.AutomationId="NavSettings" />
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Tag="About" Style="{StaticResource F1BrandItemStyle}" AutomationProperties.AutomationId="NavAbout" AutomationProperties.Name="{x:Bind ViewModel.AboutLabel, Mode=OneWay}" Margin="16,8,16,16" Padding="0" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="8"><TextBlock Text="{x:Bind ViewModel.AboutLabel, Mode=OneWay}" FontSize="14" Margin="8,0"/><TextBlock x:Name="PaneFooterText" Text="{x:Bind ViewModel.Attribution}" FontSize="12" CharacterSpacing="100" Margin="8,0" Foreground="{ThemeResource F1SecondaryBrush}" /></StackPanel>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <ContentControl x:Name="ContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
  </Grid>
</Window>
