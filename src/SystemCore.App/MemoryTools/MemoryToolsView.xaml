<UserControl x:Class="SystemCore.App.MemoryTools.MemoryToolsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:perf="using:SystemCore.App.Performance" xmlns:f1="using:SystemCore.App.DesignSystem">
  <Grid Padding="{StaticResource F1PagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="12">
   <StackPanel Spacing="12"><TextBlock x:Name="Title" Style="{StaticResource F1PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
    <f1:F1WrapPanel><Button x:Name="Analyze" Click="OnAnalyze" Style="{StaticResource F1PrimaryButtonStyle}" AutomationProperties.AutomationId="MemAnalyze" /><Button x:Name="Optimize" Click="OnOptimize" AutomationProperties.AutomationId="MemOptimize" /></f1:F1WrapPanel>
   </StackPanel>
  <TextBlock x:Name="Status" Grid.Row="1" TextWrapping="Wrap" AutomationProperties.AutomationId="MemStatus" />
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <StackPanel x:Name="Sections" Spacing="12">
     <Border x:Name="OptimizationResult" Style="{StaticResource CardStyle}"><StackPanel Spacing="8">
     <TextBlock x:Name="OptimizationSummary" TextWrapping="Wrap" AutomationProperties.AutomationId="MemOptimizationSummary" />
     <TextBlock x:Name="BeforeAfter" TextWrapping="Wrap" AutomationProperties.AutomationId="MemBeforeAfter" />
     </StackPanel></Border>
     <TextBlock x:Name="Education" TextWrapping="Wrap" />
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
    <TextBlock x:Name="Physical" FontSize="20" TextWrapping="Wrap" AutomationProperties.AutomationId="MemPhysical" />
    <TextBlock x:Name="Pressure" TextWrapping="Wrap" AutomationProperties.AutomationId="MemPressure" />
     <TextBlock x:Name="Updated" />
     </StackPanel></Border>
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
    <TextBlock x:Name="Commit" TextWrapping="Wrap" AutomationProperties.AutomationId="MemCommit" />
    <TextBlock x:Name="Cache" TextWrapping="Wrap" AutomationProperties.AutomationId="MemCache" />
     <TextBlock x:Name="PageFile" TextWrapping="Wrap" AutomationProperties.AutomationId="MemPageFile" />
     </StackPanel></Border>
    <TextBlock x:Name="History" AutomationProperties.AutomationId="MemHistory" />
     <f1:F1AdaptivePanel MaximumColumns="2"><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock x:Name="UsageTitle" /><perf:HistoryChart x:Name="UsageChart" Metric="1" FlowDirection="LeftToRight" AutomationProperties.AutomationId="MemUsageChart" /></StackPanel></Border>
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock x:Name="AvailableTitle" /><perf:HistoryChart x:Name="AvailableChart" Metric="4" FlowDirection="LeftToRight" AutomationProperties.AutomationId="MemAvailableChart" /></StackPanel></Border></f1:F1AdaptivePanel>
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
    <ComboBox x:Name="Mode" Width="220" SelectionChanged="OnMode" AutomationProperties.AutomationId="MemMode" />
    <TextBlock x:Name="Consumers" TextWrapping="Wrap" AutomationProperties.AutomationId="MemConsumers" />
    <ListView x:Name="Rows" SelectionMode="Single" SelectionChanged="OnSelection" MaxHeight="350" AutomationProperties.AutomationId="MemProcesses" />
    <TextBlock x:Name="Details" TextWrapping="Wrap" AutomationProperties.AutomationId="MemDetails" />
    <TextBlock x:Name="Technical" TextWrapping="Wrap" FlowDirection="LeftToRight" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="MemTechnical" />
    <Button x:Name="OpenLocation" Click="OnOpenLocation" AutomationProperties.AutomationId="MemOpenLocation" />
    <TextBlock x:Name="Disk" TextWrapping="Wrap" AutomationProperties.AutomationId="MemDisk" />
     <TextBlock x:Name="Network" TextWrapping="Wrap" AutomationProperties.AutomationId="MemNetwork" />
     </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
